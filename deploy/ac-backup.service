# Back up every agent's workspace as btrfs send stream files (ADR-021), run by ac-backup.timer.
# ac-ctl backup does not open the registry, so it runs while ac-gateway and the agents do. It also copies the
# control-plane state (the agent list the gateway mirrors, the tokens file, the egress agents file) to
# <dest>/_state/ (ADR-021 addendum). It reads the gateway's environment file, so AC_TOKENS and AC_EGRESS_AGENTS
# follow the gateway; a run that finds no tokens file warns.
# The destination is any directory, best a share on another machine, mounted at
# /mnt/agent-backups. To use another path, set AC_BACKUP_DEST in gateway.env (the gateway's backup
# routes read the same setting, ADR-031) and `systemctl edit ac-backup.service` to override
# RequiresMountsFor. ac-ctl backup refuses a destination that holds neither earlier backups nor the
# file .ac-backup-dest (an unmounted share's empty mount point), and marks one that holds backups.
# A run that leaves any agent without a backup (a plain-directory workspace, a full or missing share)
# exits 1, so the unit shows failed.
[Unit]
Description=agent-cloud workspace backups
RequiresMountsFor=/var/lib/agent-cloud /mnt/agent-backups

[Service]
Type=oneshot
# The default; gateway.env overrides it.
Environment=AC_BACKUP_DEST=/mnt/agent-backups
EnvironmentFile=-/etc/agent-cloud/gateway.env
ExecStart=/usr/local/bin/ac-ctl backup ${AC_BACKUP_DEST}
# Backups yield to the agents' builds.
Nice=19
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
