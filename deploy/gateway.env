# /etc/agent-cloud/gateway.env (mode 0600). AC_BIND must be a private address: loopback, RFC 1918
# or the tailnet (100.64.0.0/10). The unit strips AC_ALLOW_PUBLIC_BIND, so a public bind is refused.
# API tokens (ADR-011): /etc/agent-cloud/tokens, managed with `ac-gateway token create|list|revoke`.
#AC_TOKENS=/etc/agent-cloud/tokens
# Deprecated: one token with every scope, named `legacy` (hosts set up before ADR-011). Migrate as in
# docs/install.md, then remove it.
#AC_TOKEN_FILE=/etc/agent-cloud/gateway.token
AC_IMAGE=localhost/agent-shell:dev
AC_BIND=127.0.0.1:8780
AC_NETWORK=1
# Task API (ADR-010; docs/security.md#task-api). Defaults shown; uncomment to change.
#AC_JOB_PERMISSION_MODE=acceptEdits
#AC_JOB_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git add:*),Bash(git commit:*),Bash(ls:*),Bash(cat:*),Bash(python3:*),Bash(cargo build:*),Bash(cargo test:*),Bash(cargo check:*),Bash(cargo fmt:*),Bash(sleep:*)
#AC_JOB_UNSAFE=1
