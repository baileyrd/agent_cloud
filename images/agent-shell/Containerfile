# Shell-only agent image: Fedora + Claude Code, runs as an unprivileged user.
# The container stays up (sleep) and you attach with `ctr task exec`; see README.md.
FROM registry.fedoraproject.org/fedora:44

# Pin for reproducible images: podman build --build-arg CLAUDE_CODE_VERSION=<x.y.z> ...
ARG CLAUDE_CODE_VERSION=latest

RUN dnf install -y --setopt=install_weak_deps=False \
        nodejs npm git openssh-clients ripgrep jq procps-ng findutils which less \
        gcc gcc-c++ make python3 \
    && dnf clean all

# Installed globally by root: the agent user cannot modify or self-update it.
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force

# No sudo, no password. The workspace volume is bind-mounted at /workspace and chowned to this uid.
RUN useradd --uid 1000 --user-group --create-home --home-dir /home/agent --shell /bin/bash agent

ENV HOME=/home/agent \
    DISABLE_AUTOUPDATER=1
USER agent
WORKDIR /workspace

CMD ["sleep", "infinity"]
